{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spendly.local/contracts/schemas/common.schema.json",
  "title": "Spendly shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase canonical UUID"
    },
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decimalAmount": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,14})\\.[0-9]{2}$",
      "description": "Signed decimal with exactly 2 fraction digits and '.' as separator. Negative = money out (debit), positive = money in (credit). Never a JSON number, to keep exact precision."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileType": {
      "type": "string",
      "enum": ["CSV", "XLS", "XLSX", "PDF"]
    },
    "category": {
      "type": "string",
      "enum": [
        "GROCERIES", "RESTAURANTS", "FUEL", "TRANSPORT", "UTILITIES", "RENT_MORTGAGE", "SUBSCRIPTIONS",
        "SHOPPING", "HEALTH", "SPORT", "ENTERTAINMENT", "TRAVEL", "EDUCATION", "PETS", "CASH_WITHDRAWAL",
        "BANK_FEES", "CARD_INTEREST", "FX_FEES", "INSURANCE", "TAXES", "INCOME", "INTERNAL_TRANSFER", "OTHER"
      ]
    },
    "parser": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "e.g. kotlin-csv-generic, kotlin-csv-revolut, python-pdf-pdfplumber"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    }
  }
}
