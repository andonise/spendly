# Spendly environment variables.
# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Paths may use forward slashes on Windows (E:/spendly-data/uploads).

# --- PostgreSQL (docker-compose) -------------------------------------------
POSTGRES_DB=spendly
POSTGRES_USER=spendly
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend datasource (host process) -------------------------------------
SPENDLY_DB_URL=jdbc:postgresql://localhost:5432/spendly
SPENDLY_DB_USER=spendly
SPENDLY_DB_PASSWORD=change-me

# --- Kafka / Redpanda -------------------------------------------------------
# Host processes (backend, pdf-parser run with uv, tests) use the external listener.
# Containers on the compose network use redpanda:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_EXTERNAL_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8088

# --- Ollama (runs on the host, not in Docker) -------------------------------
# Containers use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SPENDLY_LLM_ENABLED=true

# --- Secrets (keep the files OUTSIDE the repository) ------------------------
# HMAC-SHA256 key for IBAN / person-name pseudonyms. The file holds one line of
# random text (>= 32 bytes); its UTF-8 bytes, with surrounding whitespace trimmed,
# are the key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPENDLY_HMAC_SECRET_PATH=/absolute/path/outside/repo/spendly-secrets/hmac.key

# AES-256-GCM key for the transactions.description column: base64 of exactly 32 bytes.
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SPENDLY_AES_KEY=REPLACE_WITH_BASE64_32_BYTES

# --- Uploads ---------------------------------------------------------------
# Temp folder for uploaded statements, shared by the backend and the pdf-parser.
# Event field tempFilePath is RELATIVE to this folder (see contracts/README.md).
SPENDLY_UPLOAD_DIR=/absolute/path/outside/repo/spendly-data/uploads
# How long originals are kept after a successful parse (ISO-8601 duration; PT0S = delete immediately)
SPENDLY_UPLOAD_RETENTION=PT0S
SPENDLY_UPLOAD_MAX_SIZE_MB=20

# --- Shared contracts --------------------------------------------------------
# Absolute path to the contracts/ folder (pii-rules.json, schemas). Services fall
# back to the repository's contracts/ folder when unset.
SPENDLY_CONTRACTS_DIR=

# --- Misc --------------------------------------------------------------------
SPENDLY_BASE_CURRENCY=RON
BACKEND_PORT=8080
PDF_PARSER_PORT=8090
LOG_LEVEL=INFO
