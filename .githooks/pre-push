#!/bin/sh
# Refuses pushes that would update main directly. Changes reach main only through a pull request.
# Enable once per clone: git config core.hooksPath .githooks

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push: direct pushes to main are blocked." >&2
    echo "  Push a branch and open a pull request instead:" >&2
    echo "    git switch -c feat/<name> && git push -u origin HEAD && gh pr create" >&2
    exit 1
  fi
done

exit 0
